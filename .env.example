# ==============================================================================
# GeoVigilant Argus Eye — Environment Configuration Template
# Copy this file to '.env' and fill in your API credentials as desired.
# Note: The platform operates out-of-the-box with 0 mandatory API keys.
# ==============================================================================

# --- Server & Operational Security ---
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false
SECRET_KEY=

# --- Production Deployment (Vercel Frontend & Render Backend) ---
# Set VITE_API_URL on Vercel to point to your deployed Render backend (e.g. https://geovigilant-argus-api.onrender.com)
VITE_API_URL=
# Set FRONTEND_URL on Render to your Vercel frontend domain for CORS (e.g. https://geovigilant-argus.vercel.app)
FRONTEND_URL=

# --- AI Reconnaissance Providers ---
# Local Ollama Daemon (Default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_API_KEY=
EMBEDDING_MODEL=all-minilm:latest

# OpenRouter / Anthropic Cloud Fallback
OPENROUTER_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_MODEL=nvidia/nemotron-3.5-lightning:free

# Hugging Face Hub (Optional for model router & sync)
HF_TOKEN=

# --- OSINT & Telemetry Feeds (Optional) ---
# OpenCellID (Cell Tower Triangulation)
OPENCELLID_API_KEY=

# OpenCage Geocoding
OPENCAGE_API_KEY=

# NumVerify Phone Intelligence
NUMVERIFY_API_KEY=

# HighSight & NASA
HIGHSIGHT_API_KEY=
NASA_API_KEY=

# AIS Marine Vessel Stream
AIS_API_KEY=

# WiGLE Wireless Network Reconnaissance
WIGLE_API_NAME=
WIGLE_API_TOKEN=

# MACVendors Hardware Lookup
MACVENDORS_TOKEN=

# Mapillary Street-Level Imagery (SVI)
MAPILLARY_ACCESS_TOKEN=

# ZoomEye Threat Intelligence API
ZOOMEYE_API_KEY=

# Censys Search API Token
CENSYS_API_TOKEN=

# Twitter / X API v2
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# Discord Bot & Webhooks
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=

# News Intelligence
NEWS_API_KEY=
