{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/ground", "destination": "/groundview" },
    { "source": "/surveillance", "destination": "/wifi-search" },
    { "source": "/map-w", "destination": "/wifi-search" },
    { "source": "/earthnetworks", "destination": "/newsnetworks" },
    { "source": "/social", "destination": "/news" },
    { "source": "/(tor-chat|profiles|neural|cctv|mobile|alerts|fit|settings)", "destination": "/earth" }
  ]
}
